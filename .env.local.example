# Supabase project API URL used by browser, server, and middleware clients.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key used by cookie-based SSR clients and browser clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only key for admin/service clients in API routes and server actions; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Transaction pooler connection string for app raw SQL queries; use Supabase pooler port 6543.
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct database connection for migrations and schema tools only; do not use on Vercel request paths.
SUPABASE_DB_DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
