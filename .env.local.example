# Supabase project API URL used by browser, server, and middleware clients.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key used by cookie-based SSR clients and browser clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only key for admin/service clients in API routes and server actions; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Transaction pooler connection string for app raw SQL queries; use Supabase pooler port 6543.
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct database connection for migrations and schema tools only; do not use on Vercel request paths.
SUPABASE_DB_DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Cron auth (Bearer for /api/sla/scan + /api/cron/send-emails; x-cron-key for /api/notifications/digest)
CRON_SECRET=
CRON_KEY=

# Telegram channel. NOTE: real values committed here per explicit request — ROTATE via @BotFather before any shared/public push.
TELEGRAM_BOT_TOKEN=8924786564:AAG_vSUskipxsGx4EQ6HmCSX5ogwURGbXO0
TELEGRAM_BOT_USERNAME=trinno_bot
TELEGRAM_WEBHOOK_SECRET=944db99bb011fd4dc9511717f10aa1b6f53c47f25b0c772a65261440374b3cd4

# --- PM Assistant (PMA) ---
# Server-only path to the Google Drive service-account JSON (gitignored). The
# Drive client (lib/pma/clients/drive.ts) reads this lazily. PLACEHOLDER ONLY —
# no real key here; the real file lives at .secrets/pma-sa.json (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=.secrets/pma-sa.json

# Google AI Studio key (AIza…) for Gemini. Server-only. PLACEHOLDER ONLY — do
# not commit a real key; set the real value in .env.local / vercel env.
GEMINI_API_KEY=replace-me

# PMA test-fixture Drive folder IDs (NOT secrets — these are SA-shared test
# folders). Source = read-only; Output = trinno writes here. Used by the
# Drive smoke check (scripts/pma/drive-smoke.ts).
PMA_TEST_SOURCE_FOLDER_ID=1RI4P1hLK622dhlqD2IcUiMcSbnr_W4xa
