# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# stryker mutation testing artifacts
/.stryker-tmp
/reports/mutation

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local
supabase/.branches
supabase/.temp
.env.local
.env*.local

# Secrets — plaintext prod env, never commit
scripts/set-prod-env.sh
.secrets/
*-service-account*.json
*gserviceaccount*.json

# Prod seed/delete ops scripts — may carry prod keys, keep local only
scripts/seeds/*-prod.sh

# Seed planning docs carry inline prod keys — keep local only, never push
docs/features/collabora-innova-seed/
docs/features/filse-spazio-wildfire-seed/

# DB backups + local artifacts
backup-*.sql
error.log
*.pdf

# Stray root screenshots / scratch images
/image.png
/image copy*.png
/image*.png
docs/ai-agent-user-preferences-workflow.html
.gstack/

# Local planning/scratch docs — keep out of the repo
/FEATURE-UNIVERSE.md
/PMA-test-doc.md
/PROJECT-MAP.md
/Work Package*.xlsx
